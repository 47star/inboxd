{
  "version": 1,
  "lineLength": 100,
  "indentation": {"spaces": 4},
  "maximumBlankLines": 1,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": true,
  "lineBreakBeforeEachGenericRequirement": true,
  "rules": {
    "DoNotUseSemicolons": true,
    "OneVariableDeclarationPerLine": true,
    "OrderedImports": true
  }
}
